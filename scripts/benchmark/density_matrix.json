{
  "schema_version": "1.0",
  "intent": "B3-X3 density benchmark pressure ladder contract. Defines four on-screen enemy density levels (5/20/50/100) that reuse the existing combat harness capability end to end: entrance via goto_test_level (the existing launcher key sequence, no new in-game system), deterministic seeded spawn plans rendered with enum mob resources from scripts/validate/combat_scenarios.json, and telemetry written by the existing ScenarioDirector single bus. This file carries ONLY the benchmark framework; it changes no gameplay density value anywhere in mods/.",
  "entrance": {
    "routing": "goto_test_level",
    "mechanism": "复用既有 harness 路由：scripts/validate/launch_harness_game.py 的 Enter/Enter/F10 goto_test_level 键位序列进入 TestLevel，k5-combat-harness ScenarioDirector.gd 消费 game_request（scenario_id/seed/duration/plan）并写出 telemetry；不新建任何游戏内系统",
    "launcher_relative_path": "scripts/validate/launch_harness_game.py",
    "new_in_game_system": "none"
  },
  "levels": [
    {
      "id": "density_5",
      "label": "5",
      "version": 1,
      "summary": "Pressure ladder L1: 5 skeleton warriors on screen. Reference floor: frame-time/FPS/event-rate baseline at the density the base game already reaches.",
      "default_seed": 2026083001,
      "duration_seconds": 60.0,
      "end_condition": {
        "type": "all_mobs_dead_or_timeout",
        "timeout_seconds": 60.0
      },
      "spawn": {
        "mode": "ladder",
        "ladder": {
          "x": 0,
          "y": 0,
          "wave": 1
        },
        "origin": [180.0, 0.0],
        "spread": 300.0
      },
      "player": {
        "position": [0.0, 0.0]
      },
      "mob_composition": [
        {
          "mob": "skeleton_warrior",
          "count": 5
        }
      ],
      "metrics": {
        "frame_time": {
          "targets": ["avg_ms", "p95_ms", "p99_ms", "max_ms"]
        },
        "fps": {
          "targets": ["avg", "min", "p1"]
        },
        "event_rate": {
          "events": ["damage_events", "melee_hits", "crits", "projectiles", "triggers"],
          "unit": "events_per_second",
          "spine": "B2-X1 combat event spine (single bus)"
        },
        "voice_budget": {
          "limit_concurrent": 16,
          "funnel": "k4 single funnel (B1 k4-audio-foundation)"
        },
        "camera_budget": {
          "limit_amplitude": 4.0,
          "limit_offset": 3.5,
          "source": "B2-X5 get_camera_impulse_telemetry()"
        }
      },
      "asserts": [
        {
          "label": "boot_ok",
          "field": "boot.ok",
          "op": "==",
          "value": true,
          "capability": "required"
        },
        {
          "label": "all_five_spawned",
          "field": "counters.spawned",
          "op": ">=",
          "value": 5,
          "capability": "required"
        },
        {
          "label": "all_five_killed",
          "field": "counters.killed",
          "op": ">=",
          "value": 5,
          "capability": "required"
        },
        {
          "label": "no_duplicate_death",
          "field": "counters.duplicate_deaths",
          "op": "==",
          "value": 0,
          "capability": "required"
        },
        {
          "label": "draft_fps_floor",
          "field": "perf.fps_avg",
          "op": ">=",
          "value": 30.0,
          "capability": "optional"
        }
      ],
      "proves": "a stable 5-on-screen baseline that renders a deterministic seeded plan and settles every death exactly once on the candidate",
      "not_proven": "gameplay density values of the real game (unmodified), frame-time percentiles and budgets without a benchmark-capable candidate, S5 feel",
      "requires": ["boot", "killed", "duplicate_deaths", "fps", "metrics"],
      "stress": true
    },
