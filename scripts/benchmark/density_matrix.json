  "thresholds": {
    "draft": true,
    "calibration_note": "全部阈值为草案（B3-X3 只建基线框架）：需 VM 真实数据校准后才能 gate（后续批次）。校准前阈值只报告、不打分、不影响 PASS/FAIL 判定；仅 level 内 requires/asserts 参与判定。",
    "frame_time_p95_ms": {
      "max": 33.33,
      "rationale": "30fps 地板等效（与既有 fps_floor=30 草案一致）",
      "draft": true
    },
    "frame_time_p99_ms": {
      "max": 50.0,
      "rationale": "尾部帧保护草案（p99 不容许长时间卡顿窗口）",
      "draft": true
    },
    "fps_avg": {
      "min": 30.0,
      "rationale": "与 cluster_kill_20 既有 fps_floor 草案同值",
      "draft": true
    },
    "fps_p1": {
      "min": 20.0,
      "rationale": "长尾帧保护草案（1% 帧仍须维持可玩）",
      "draft": true
    },
    "event_rate": {
      "max_per_second": null,
      "rationale": "只记录不设上限；峰值由聚合/预算机制（voice 16 / camera clamp / X6 层窗口）吸收",
      "draft": true
    },
    "voice_max_concurrent": {
      "max": 16,
      "rationale": "k4 单漏斗 16 concurrent voice budget（B1 k4-audio-foundation）",
      "draft": true
    },
    "voice_over_budget_count": {
      "max": 0,
      "rationale": "任意超预算即丧失漏斗语义；草案期报告超标帧数",
      "draft": true
    },
    "camera_max_amplitude": {
      "max": 4.0,
      "rationale": "X5 IMPULSE_BUDGET_MAX 常量（B2-X5 camera impulse）",
      "draft": true
    },
    "camera_max_offset": {
      "max": 3.5,
      "rationale": "X5 IMPULSE_MAX_OFFSET 安全帽常量",
      "draft": true
    },
    "camera_capped_ratio": {
      "max": 0.1,
      "rationale": "钳制占比草案：capped_amplitude_count / impulses_total 不超 10%（需真实数据校准）",
      "draft": true
    }
