        "timeout_seconds": 30.0
      },
      "spawn": {
        "mode": "ladder",
        "ladder": {
          "x": 0,
          "y": 0,
          "wave": 1
        },
        "origin": [200.0, 0.0],
        "spread": 350.0
      },
      "player": {
        "position": [0.0, 0.0]
      },
      "mob_composition": [
        {
          "mob": "zombie",
          "count": 6
        }
      ],
      "asserts": [
        {
          "label": "boot_ok",
          "field": "boot.ok",
          "op": "==",
