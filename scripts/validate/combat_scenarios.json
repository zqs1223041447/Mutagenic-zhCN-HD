      ],
      "stress": false
    },
    {
      "id": "stress_random_300",
      "version": 1,
      "summary": "Legacy stress: 300 random mobs via the existing ladder spawner path (spawn_cluster_in_ladder(0,0,300,wave)) with an explicit seed. Kept as the independent stress scenario; NOT a determinism-by-mob-type scenario (composition is random by design).",
      "default_seed": 2026082008,
      "duration_seconds": 60.0,
      "end_condition": {
        "type": "timeout",
        "timeout_seconds": 60.0
      },
      "spawn": {
        "mode": "ladder",
        "ladder": {
          "x": 0,
          "y": 0,
          "wave": 1
        },
        "origin": [200.0, 0.0],
        "spread": 500.0
      },
      "player": {
        "position": [0.0, 0.0]
      },
      "mob_composition": [
        {
          "mob": "random",
          "count": 300
        }
      ],
      "asserts": [
        {
          "label": "boot_ok",
          "field": "boot.ok",
          "op": "==",
          "value": true,
          "capability": "required"
        },
        {
          "label": "all_three_hundred_spawned",
          "field": "counters.spawned",
          "op": ">=",
          "value": 300,
