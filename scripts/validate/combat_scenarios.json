      "not_proven": "deterministic mob composition (random by design); kill/crit balance; performance on slower hosts; any combat feel",
      "requires": [
        "boot",
        "spawned",
        "fps",
        "duplicate_deaths"
      ],
      "stress": true
    }
  ]
}