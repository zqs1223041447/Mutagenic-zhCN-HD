{
  "schema_version": 1,
  "intent": "B2-X2 Combat S5 evidence aspect catalog. Each aspect is a uniform evidence format for one player-perceivable combat property: same scenario id / same seed / same spawn composition+positions / same camera start on BOTH sides (baseline and candidate). Scenario bindings MUST reference scenario ids declared in scripts/validate/combat_scenarios.json (B1-X5 catalog). The machine prepares evidence packages only; HUMAN_ACCEPTED is a human-only conclusion and never appears in machine-generated output.",
  "aspects": [
    {
      "id": "player_response",
      "summary": "Player Response: movement/turn/dash/repeat-cast responsiveness, input-loss and drift checks.",
      "wave": "A",
      "depends_on_event_spine": false,
      "default_scenario": "movement_dash_smoke",
      "scenario_bindings": [
        {
          "scenario": "movement_dash_smoke",
          "camera_start": [0.0, -180.0],
          "capture_points": [
            {"id": "start_frame", "at": 0.0, "kind": "screenshot", "required": true, "telemetry_fields": ["boot.ok"]},
            {"id": "dash_start", "at": 2.0, "kind": "screenshot", "required": true, "telemetry_fields": ["counters.dashes"]},
            {"id": "dash_recover", "at": 2.8, "kind": "screenshot", "required": true, "telemetry_fields": ["counters.dashes"]},
            {"id": "move_strafe", "at": 5.0, "kind": "screenshot", "required": true, "telemetry_fields": ["counters.player_moves"]},
            {"id": "dash_sequence", "at": 6.0, "kind": "frame_sequence", "required": false, "telemetry_fields": ["counters.dashes"]}
          ]
        },
        {
          "scenario": "rapid_hit_10s",
          "camera_start": [0.0, -180.0],
          "capture_points": [
            {"id": "start_frame", "at": 0.0, "kind": "screenshot", "required": true, "telemetry_fields": ["boot.ok"]},
            {"id": "repeated_action", "at": 3.0, "kind": "screenshot", "required": true, "telemetry_fields": ["counters.melee_hits"]},
            {"id": "sustained_movement", "at": 7.0, "kind": "screenshot", "required": true, "telemetry_fields": ["counters.player_moves"]},
            {"id": "ten_second_soak", "at": 9.5, "kind": "video", "required": false, "telemetry_fields": ["perf.fps_avg"]}
          ]
        }
      ],
      "checklist": [
        {"id": "pr_01", "question": "整体跟手度：哪个版本控制更直接？", "response_type": "prefer_side"},
        {"id": "pr_02", "question": "移动/转向响应直接感（1 很糊, 5 很直接）", "response_type": "score_1_5"},
        {"id": "pr_03", "question": "Dash 启动与收尾可读性（1 难判断, 5 清晰）", "response_type": "score_1_5"},
        {"id": "pr_04", "question": "高速施法/连续 Dash 是否出现输入丢失（被吞）？", "response_type": "yes_no"},
        {"id": "pr_05", "question": "是否出现滑动失控或穿过碰撞？", "response_type": "yes_no"},
        {"id": "pr_06", "question": "其他观察（自由文本）", "response_type": "free_text"}
      ]
    },
