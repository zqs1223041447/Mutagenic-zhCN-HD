      "ladder": {
        "x": 0,
        "y": 0,
        "wave": 1
      },
      "origin": [
        180.0,
        0.0
      ],
      "spread": 300.0
    },
    "player": {
      "position": [
        0.0,
        0.0
      ]
    },
    "mob_composition": [
      {
        "mob": "skeleton_warrior",
        "count": 10
      },
      {
        "mob": "skeleton_archer",
        "count": 5
      },
      {
        "mob": "zombie",
        "count": 5
      }
    ],
    "asserts": [
      {
        "label": "boot_ok",
        "field": "boot.ok",
        "op": "==",
        "value": true,
        "capability": "required"
      },
      {
        "label": "all_twenty_spawned",
        "field": "counters.spawned",
        "op": ">=",
        "value": 20,
        "capability": "required"
      },
      {
        "label": "cluster_fully_killed",
        "field": "counters.killed",
        "op": ">=",
        "value": 20,
        "capability": "required"
      },
      {
        "label": "no_duplicate_death",
        "field": "counters.duplicate_deaths",
        "op": "==",
        "value": 0,
        "capability": "required"
      },
      {
        "label": "fps_floor",
        "field": "perf.fps_avg",
        "op": ">=",
        "value": 30.0,
        "capability": "optional"
      }
    ],
    "proves": "that a 20-mob mixed cluster is spawned deterministically, fully killed, and that every death is settled exactly once under the declared seed on the candidate",
    "not_proven": "visual noise level, kill-feedback pacing, audio/camera aggregation, or cluster-kill feel (those need B1-X2/X4 plus an S5 human checkpoint)",
    "requires": [
      "boot",
      "killed",
      "duplicate_deaths",
      "fps"
    ],
    "stress": false
