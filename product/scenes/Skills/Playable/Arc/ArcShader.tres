[gd_resource type="Shader" format=3]

[resource]
code = "shader_type canvas_item;

uniform float amt : hint_range(0.0, 1.0);
uniform float speed = 1.0;
uniform vec4 color : source_color;
uniform sampler2D noise_img;

float circle(vec2 position, float radius, float feather)
{
	return smoothstep(radius, radius + feather, dot(position, position) * 4.0);
}


void fragment() 
{
    float outer = circle(UV-vec2(0.5,0.5), 1.0, 0.01);
    float inner = circle(UV-vec2(0.5,0.5), 0.99, 0.01);
    COLOR = color;
    COLOR.a = 0.0;
    if (abs(outer - inner) > 0.0) {
        COLOR.a = 0.5;
    } else {
        float dist = distance(UV, vec2(0.5,0.5));
   	if (dist > amt/2.0) 
   	{
  		COLOR = vec4(0.0);
   	}
        else if (dist == amt/2.0) {
            COLOR = vec4(1.0);
        }
   	else 
   	{
  		COLOR = vec4(color);
            
            vec2 uv1 = vec2(UV.x + TIME * speed, UV.y);
            vec2 uv2 = vec2(UV.x - TIME * speed, UV.y);
            vec2 uv3 = vec2(UV.x, UV.y + TIME * speed);
            
            float noise_r = texture(noise_img, uv1).r;
            float noise_g = texture(noise_img, uv2).g;
            float noise_b = texture(noise_img, uv3).b;
            float alpha = noise_r * noise_g * noise_b * (1.0 - 2.0 * dist);
            COLOR.a = alpha * 5.0;
        }
	}
}"
