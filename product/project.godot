[layer_names]

2d_physics/layer_1="Player Collider"
2d_physics/layer_2="Enemy Collider"
2d_physics/layer_3="Projectiles"
2d_physics/layer_5="Mob Ground Bodyblocking"
2d_physics/layer_6="Mob Flying Bodyblocking"
2d_physics/layer_9="Environment"
2d_physics/layer_10="Interactables"

[physics]

2d/default_gravity=0.0
2d/default_gravity_vector=Vector2(0, 0)
2d/default_linear_damp=0.0

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.254902, 0.254902, 0.254902, 1)

