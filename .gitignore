# ============================================================
/06_worktree/
/07_compiled/
/08_pack/
/09_output/
/10_logs/
/build/
/artifacts/
/archive/
# Build performance persistent caches (see docs/build/COMPILE_PERFORMANCE_PLAN.md §2-§8)
# default <repo_root>/.cache/  (overridable via MUTAGENIC_CACHE_ROOT); never track
/.cache/
# ============================================================
# Runtime state
# ============================================================
/SavesDir/
/local/
/tmp/
/temp/
