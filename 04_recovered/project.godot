[layer_names]

2d_physics/layer_1="Player Collider"
2d_physics/layer_2="Enemy Collider"
2d_physics/layer_3="Projectiles"
2d_physics/layer_5="Mob Ground Bodyblocking"
2d_physics/layer_6="Mob Flying Bodyblocking"
2d_physics/layer_9="Environment"
2d_physics/layer_10="Interactables"

[logging]

file_logging/max_log_files=25

[memory]

limits/command_queue/multithreading_queue_size_kb=1024

[network]

limits/debugger_stdout/max_chars_per_second=64000

[physics]

2d/bp_hash_table_size=32000
2d/cell_size=8
2d/default_gravity=0
2d/default_gravity_vector=Vector2( 0, 0 )
2d/default_linear_damp=0.0

[rendering]

2d/options/use_nvidia_rect_flicker_workaround=true
2d/snapping/use_gpu_pixel_snap=true
environment/default_clear_color=Color( 0.254902, 0.254902, 0.254902, 1 )
environment/default_environment="res://default_env.tres"
environment/stretch/aspect="keep"
