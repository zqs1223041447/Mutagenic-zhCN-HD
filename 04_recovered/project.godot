[display]

window/size/width=1280
window/size/height=800
window/size/fullscreen=true
mouse_cursor/custom_image="res://sprites/gui/cursor.png"
mouse_cursor/custom_image_hotspot=Vector2( 32, 32 )
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PoolStringArray( "res://addons/AsepriteWizard/plugin.cfg" )

[gdnative]

singletons=[  ]

[global]

output=false
verbose=false

[gui]

timers/tooltip_delay_sec=0.0

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": false,
